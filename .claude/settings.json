{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-prd-writes.cjs"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/guard-inline-implementation.cjs"
          }
        ]
      }
    ]
  }
}
