# Tracked deliberately (unlike settings.local.json): the guard-prd-writes
# PreToolUse hook must be active for every clone/worktree/headless scheduler
# run against this repo, not just this machine's local config — see
# scripts/hooks/guard-prd-writes.cjs's header for the install/uninstall note.
!.claude/settings.json
.research/

# Generated scheduler skill-discovery output (not source)
skill-proposals/
.playwright-mcp/
# Root-only: kept for stale pre-2026-09-13 installs whose systemd unit still
# points here — the watchdog now logs under ~/.claude/session-manager/logs/,
# never a repo dir anything can delete out from under a running timer. MUST
# stay anchored — a bare `logs/` also matches session-manager-operations/logs/,
# hiding the owned ops error-log namespace from git (incident: PRD 1181, 2026-09-12).
/logs/

# Written by scripts/write-build-info.cjs (prepack + prepublishOnly) from the
# PUBLISHING checkout — never committed, but still reaches the npm tarball
# because package.json's files[] "src/main/" entry overrides .gitignore. A
# dev checkout / job worktree has no build-info.json, so
# src/main/lib/buildIdentity.cjs falls back to a live git read instead.
src/main/build-info.json
