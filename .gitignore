test-results
playwright-report
.env
.env.local
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/builder.md
!.claude/agents/page-*.md
# Tracked deliberately (unlike settings.local.json): the guard-prd-writes
# PreToolUse hook must be active for every clone/worktree/headless scheduler
# run against this repo, not just this machine's local config — see
# scripts/hooks/guard-prd-writes.cjs's header for the install/uninstall note.
!.claude/settings.json
# Project environment override (jobs may GET bilko.run for live release checks).
!.claude/environments/
.claude/environments/*
!.claude/environments/headless-default.json
.research/

# Generated scheduler skill-discovery output (not source)
skill-proposals/
.playwright-mcp/
# Root-only: kept for stale pre-2026-09-13 installs whose systemd unit still
# points here — the watchdog now logs under ~/.claude/session-manager/logs/,
# never a repo dir anything can delete out from under a running timer. MUST
# stay anchored — a bare `logs/` also matches session-manager-operations/logs/,
# hiding the owned ops error-log namespace from git (incident: PRD 1181, 2026-09-12).
/logs/

# Written by scripts/write-build-info.cjs (prepack + prepublishOnly) from the
# PUBLISHING checkout — never committed, but still reaches the npm tarball
# because package.json's files[] "src/main/" entry overrides .gitignore. A
# dev checkout / job worktree has no build-info.json, so
# src/main/lib/buildIdentity.cjs falls back to a live git read instead.
src/main/build-info.json

# Operational runtime state — written continuously by the scheduler / Epic
# store, machine-local, never source. Authored docs under
# session-manager-operations/ (architecture, manual, design-mocks, reviews,
# project-brief, project-pages, HUMAN_LEARN, CLAUDE.md) stay tracked.
session-manager-operations/scheduler/*
!session-manager-operations/scheduler/README.md
session-manager-operations/prompt-sessions/*
!session-manager-operations/prompt-sessions/README.md
# Retired 2026-08-02, not a runtime namespace: keeps this repo's leftover folder ignored.
session-manager-operations/feedback/
session-manager-operations/logs/*
!session-manager-operations/logs/README.md
session-manager-operations/ui-prefs/*
!session-manager-operations/ui-prefs/README.md
session-manager-operations/memory-clusters/*
!session-manager-operations/memory-clusters/README.md
session-manager-operations/tasks/*
!session-manager-operations/tasks/README.md
session-manager-operations/plan-records/*
!session-manager-operations/plan-records/README.md
session-manager-operations/events/*
!session-manager-operations/events/README.md
session-manager-operations/agents/*
