{
  "name": "claude-code-session-manager",
  "version": "0.108.0",
  "description": "Local cockpit for the Claude Code CLI — multi-tab terminal, full config surface, scheduler, voice dictation, and live observability.",
  "type": "module",
  "main": "src/main/index.cjs",
  "bin": {
    "claude-code-session-manager": "bin/cli.cjs"
  },
  "files": [
    "bin/",
    ".claude-plugin/",
    "plugins/",
    "scripts/mint-epic.cjs",
    "scripts/scheduler-mcp-server.cjs",
    "scripts/ops-sweep.cjs",
    "scripts/audit-ops-hygiene.cjs",
    "scripts/hooks/guard-prd-writes.cjs",
    "scripts/hooks/guard-destructive-git.cjs",
    "scripts/hooks/guard-inline-implementation.cjs",
    "scripts/hooks/guard-self-schedule.cjs",
    "scripts/hooks/lib/guard-destructive-git-policy.cjs",
    "scripts/hooks/lib/guard-self-schedule-policy.cjs",
    "scripts/hooks/lib/guard-prd-writes-policy.cjs",
    "scripts/hooks/lib/guard-inline-implementation-policy.cjs",
    "src/main/",
    "src/preload/",
    "src/seed/",
    "dist/index.html",
    "dist/assets/",
    "dist/vad/",
    "README.md",
    "!src/**/__tests__/**"
  ],
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && SM_DEV=1 electron .",
    "build": "vite build",
    "dist:stage": "npm run build && node scripts/package/stage.cjs",
    "dist:mac": "npm run dist:stage && electron-builder --config electron-builder.yml --mac --publish never",
    "dist:win": "npm run dist:stage && electron-builder --config electron-builder.yml --win --publish never",
    "dist:linux": "npm run dist:stage && electron-builder --config electron-builder.yml --linux --publish never",
    "dist:linux-dir": "npm run dist:stage && electron-builder --config electron-builder.yml --linux dir --publish never",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.main.json",
    "start": "electron .",
    "prepack": "node scripts/write-build-info.cjs",
    "prepublishOnly": "node scripts/write-build-info.cjs && vite build",
    "test:unit": "vitest run",
    "test:unit:stability": "bash scripts/test-unit-stability.sh",
    "bench": "node scripts/bench/main-bench.cjs",
    "bench:renderer": "vitest run --config vitest.bench.config.ts",
    "test:e2e": "xvfb-run -a playwright test",
    "smoke:darwin": "playwright test tests/smoke/darwin-boot.spec.ts",
    "smoke:packaged": "playwright test tests/smoke/packaged-boot.spec.ts",
    "refresh:vad-assets": "node scripts/refresh-vad-assets.mjs",
    "health": "node src/main/health.cjs",
    "manual:check": "node web/manual/build.mjs --check",
    "manual:readability": "node web/manual/readability.mjs",
    "manual:build": "node web/manual/build.mjs",
    "manual:figures": "xvfb-run -a node web/manual/capture-figures.mjs",
    "lint:selectors": "node scripts/check-unstable-selectors.cjs",
    "lint:hooks": "node scripts/check-conditional-hooks.cjs",
    "lint:docs": "node scripts/check-doc-hierarchy.cjs",
    "lint:paths": "node scripts/check-ops-path-literals.cjs",
    "lint:any": "node scripts/check-explicit-any.cjs",
    "lint:main-ts-check": "node scripts/check-main-ts-check.cjs",
    "lint:filenames": "node scripts/check-tracked-filenames.cjs",
    "lint:renderer-storage": "node scripts/check-renderer-storage.cjs",
    "lint": "npm run lint:selectors && npm run lint:hooks && npm run lint:docs && npm run lint:paths && npm run lint:any && npm run lint:main-ts-check && npm run lint:filenames && npm run lint:renderer-storage",
    "sync:settings-schema": "node scripts/sync-settings-schema.cjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "terminal",
    "electron",
    "session-manager",
    "cli",
    "cockpit",
    "mcp",
    "agents",
    "hooks",
    "scheduler",
    "voice",
    "speech-to-text",
    "prd"
  ],
  "author": "bilkobibitkov",
  "license": "MIT",
  "homepage": "https://bilko.run/projects/session-manager/",
  "repository": {
    "type": "git",
    "url": "https://github.com/StanislavBG/claude-code-session-manager.git"
  },
  "bugs": {
    "url": "https://github.com/StanislavBG/claude-code-session-manager/issues"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://bilko.run/coffee"
    },
    {
      "type": "individual",
      "url": "https://bilko.run/projects/session-manager/"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "dompurify": "^3.4.8",
    "@hono/node-server": "^1.19.15",
    "fast-uri": "^3.1.8",
    "hono": "^4.13.7",
    "ip-address": "^10.7.1",
    "qs": "^6.16.0",
    "tar": "^7.5.21",
    "undici": "^7.29.1"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dependencies": {
    "chokidar": "^4.0.1",
    "electron": "42.11.11",
    "node-pty": "^1.2.0-beta.12",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@monaco-editor/react": "^4.6.0",
    "@playwright/test": "^1.59.1",
    "@ricky0123/vad-web": "^0.0.31",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "dockview-react": "^6.6.1",
    "dompurify": "^3.4.8",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "marked": "^14.0.0",
    "monaco-editor": "0.57.0",
    "onnxruntime-web": "^1.24.3",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "4.1.6",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.0"
  }
}
