{
  "$comment": "Per-figure capture recipes consumed by scripts/capture-manual-figures.mjs. Every <figure data-figure=\"...\"> declared in session-manager-operations/manual/chapters/*.html must have a matching entry here, keyed by that id, EXCEPT the figures listed in this script's own KNOWN_UNREACHABLE (see src/main/__tests__ / manual figure-coverage test) — those are surfaces the script genuinely cannot reach (a state it has no way to produce) and are deliberately left out rather than shipping a recipe known to fail. navKey is a CommandPalette 'nav:<key>' id (see src/renderer/components/CommandPalette.tsx). steps run in order before the screenshot; each callout selector is resolved to a live DOM bounding box at capture time — never a hardcoded pixel guess. Many selectors below are plain text=/class selectors rather than data-testid, because the underlying screens (Agent Library, Tag Library, MCP Servers, Hooks, Memory, Settings, Plugins, History, Home) carry zero data-testid attributes as of this writing — verified by grep, not assumed.",
  "first-launch": {
    "navKey": "project-home",
    "waitForSelector": "[data-testid=\"tour-statusbar\"]",
    "callouts": [
      { "arrow": "left", "selector": "[data-testid=\"tour-leftnav\"]" },
      { "arrow": "up", "selector": "[data-testid=\"tour-new-session\"]" },
      { "arrow": "down", "selector": "[data-testid=\"tour-statusbar\"]" }
    ]
  },
  "scheduler-queue": {
    "navKey": "scheduler",
    "waitForSelector": "[role=\"status\"][aria-label^=\"Status:\"]",
    "callouts": [
      { "arrow": "left", "selector": "button:has-text(\"Queue\")" },
      { "arrow": "up", "selector": "select[title^=\"when-available:\"]" },
      { "arrow": "right", "selector": "[role=\"status\"][aria-label^=\"Status:\"]" }
    ]
  },
  "epic-views": {
    "navKey": "terminal",
    "steps": [
      { "action": "click", "selector": "[data-testid=\"epic-queue-row\"]" }
