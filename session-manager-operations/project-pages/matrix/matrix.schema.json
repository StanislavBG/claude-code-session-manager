{
  "$id": "session-manager/competitive-matrix.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "self"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "maxLength": 600
        }
      },
      "required": [
        "id",
        "name",
        "summary"
      ],
      "additionalProperties": false
    },
    "competitors": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "category": {
            "type": "string",
            "maxLength": 60
          },
          "chosenBy": {
            "type": "string",
            "enum": [
              "user",
              "auto"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 600
          }
        },
        "required": [
          "id",
          "name",
          "category",
          "chosenBy",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "maxLength": 400
          }
        },
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "features": {
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "groupId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "sentiment": {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "enum": [
                  "loved",
                  "requested",
                  "mixed",
                  "complained",
                  "none"
                ]
              },
              "summary": {
                "type": "string",
                "maxLength": 600
              },
              "sourceIds": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "signal",
              "summary",
              "sourceIds"
            ],
            "additionalProperties": false
          },
          "support": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "partial",
                    "no",
                    "unknown"
                  ]
                },
                "note": {
                  "type": "string",
                  "maxLength": 400
                },
                "sourceIds": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                  }
                }
              },
              "required": [
                "status",
                "note",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "recommendation": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  "none"
                ]
              },
              "rationale": {
                "type": "string",
                "maxLength": 1000
              },
              "sessionGoal": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "priority",
              "rationale",
              "sessionGoal"
            ],
            "additionalProperties": false
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "groupId",
          "title",
          "description",
          "sentiment",
          "support",
          "recommendation",
          "firstSeenAt",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "maxItems": 600,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "publisher": {
            "type": "string",
            "maxLength": 80
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "announcement",
              "blog",
              "docs",
              "changelog",
              "forum",
              "review",
              "social",
              "repo"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "title",
          "publisher",
          "publishedAt",
          "retrievedAt",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "model": {
            "type": "string",
            "maxLength": 60
          },
          "competitors": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 80
            }
          },
          "added": {
            "maxItems": 300,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "changed": {
            "maxItems": 300,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "at",
          "model",
          "competitors",
          "added",
          "changed",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "product",
    "competitors",
    "groups",
    "features",
    "sources",
    "runs",
    "updatedAt"
  ],
  "additionalProperties": false
}
