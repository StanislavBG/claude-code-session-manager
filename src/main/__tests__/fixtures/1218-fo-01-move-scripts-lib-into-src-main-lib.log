{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01REcwjQASmJNcLYJrdkF8Ln","type":"tool_result","content":"1\t'use strict';\n2\t\n3\t// activeSessions.cjs — returns distinct on-disk project cwds with an active\n4\t// session within maxAgeMin minutes. Used by the feedback sweep (PRD 102) to\n5\t// narrow scanning to projects the user is actually working in.\n6\t//\n7\t// Detection is transcript-based only (scans ~/.claude/projects/*/*.jsonl\n8\t// mtimes). It has zero dependency on ~/.claude/knowledge-log/prompts.jsonl,\n9\t// which PRD 356-retire purges along with its capture hook.\n10\t\n11\tconst fs = require('node:fs');\n12\tconst os = require('node:os');\n13\tconst path = require('node:path');\n14\tconst { KIND_CONFIG: WORKTREE_KIND_CONFIG } = require('../../src/main/lib/gitWorktree.cjs');\n15\t\n16\tconst HOME = os.homedir();\n17\tconst TMPDIR = os.tmpdir();\n18\t\n19\t// The last-resort drop targets for addCwd's tmp guard.\n20\t//   - exactDropCwds: dropped only on an EXACT match — os.tmpdir() itself\n21\t//     (e.g. `/tmp`). NOT a prefix match: this codebase's own test suite\n22\t//     routinely stubs HOME to a tmp dir and nests a fake project cwd\n23\t//     underneath it, a legitimate, unrelated use of os.tmpdir() that a\n24\t//     blanket prefix match would wrongly drop.\n25\t//   - prefixDropRoots: dropped on an exact match OR any nested path — the two\n26\t//     managed worktree roots (both live under os.tmpdir() per gitWorktree\n27\t//     .cjs's KIND_CONFIG). Nothing but managed worktree checkouts is ever\n28\t//     created under these roots, so a prefix match here is safe. A resolvable\n29\t//     worktree (managed or user-made, anywhere on disk) is already handled by\n30\t//     worktreeMainRootOf above; this guard only catches what that resolution\n31\t//     could not — e.g. a bare, .git-less worktree-root directory.\n32\tconst TMP_DROP_ROOTS = {\n33\t  exactDropCwds: [TMPDIR],\n34\t  prefixDropRoots: [WORKTREE_KIND_CONFIG.job.root, WORKTREE_KIND_CONFIG.epic.root],\n35\t};\n36\t\n37\t// Transcript reads only need the last line with a `cwd` field — a few dozen\n38\t// lines is always enough. 64 KB keeps peak RSS proportionate.\n39\tconst TAIL_BYTES = 64 * 1024;\n40\t\n41\t// Safety cap on distinct cwds to bound result set size. O(1) extra space.\n42\tconst MAX_CWDS = 50;\n43\t\n44\t// activeProjectCwds' scan is a readdirSync of every dir under ~/.claude\n45\t// /projects (2209 dirs / 8.8 GB observed) plus a statSync per transcript —\n46\t// ~270 ms warm. reconcile() calls into it (directly or via allProjectCwds)\n47\t// several times per pass, so cache the resolved cwd list keyed on the\n48\t// resolved argument TUPLE (projectsDir, maxAgeMin, maxCwds) — never on\n49\t// `!opts`, since allProjectCwds always constructs an options object and that\n50\t// guard would cache nothing on the hottest path.\n51\t//\n52\t// Invalidation: projectsDir's own mtime (bumps when a project DIRECTORY is\n53\t// added/removed — NOT when an existing transcript gains a line, which is\n54\t// fine: a project already in the list stays in the list) plus a short TTL\n55\t// as the backstop for everything else. Same mtime-keyed idiom as\n56\t// scheduler/prdParser.cjs's dirCache and queueHistory.cjs's historyCacheKey.\n57\tconst CACHE_TTL_MS = 30_000;\n58\tconst cwdScanCache = new Map(); // key -> { dirMtimeMs, cachedAt, result }\n59\t\n60\t/** Forces the next activeProjectCwds/allProjectCwds call to rescan. */\n61\tfunction bustProjectCwdCache() {\n62\t  cwdScanCache.clear();\n63\t}\n64\t\n65\t// The ops-root folder name. A transcript's `cwd` can point INSIDE it whenever\n66\t// an agent `cd`s into an artifact directory (a PRD folder, prompt-sessions,\n67\t// scheduler/state) — Claude Code records the new absolute cwd on every\n68\t// subsequent row, and this scan reads the LAST such row. Left unnormalized,\n69\t// that subdirectory is handed to consumers as if it were a project, and\n70\t// queueStore.writeSplit materializes a whole second ops root beneath it:\n71\t// `<project>/session-manager-operations/scheduler/epics/<id>/prds/session-\n72\t// manager-operations/scheduler/state/queue.json`, holding `{\"jobs\": []}`.\n73\t// Observed live on 2026-08-30 in starry-night-ships: 14 such stubs, mtimes\n74\t// spanning 8 days, one per directory an agent had cd'd into.\n75\t//\n76\t// Truncating at the segment is strictly better than dropping the row: the\n77\t// ancestor IS the project the agent was working in, so the active-project\n78\t// signal survives instead of being silently lost.\n79\tconst OPS_DIRNAME = 'session-manager-operations';\n80\t\n81\t// Bound on the ancestor walk in worktreeMainRootOf — well past any real\n82\t// filesystem depth, purely to guarantee termination without relying on\n83\t// reaching '/' (e.g. a symlink loop or an unusually deep path).\n84\tconst MAX_WORKTREE_WALK = 40;\n85\t\n86\tconst WORKTREES_MARKER = `${path.sep}.git${path.sep}worktrees${path.sep}`;\n87\t\n88\t/**\n89\t * worktreeMainRootOf(cwd) → the main tree's root when cwd sits inside a\n90\t * linked `git worktree` (job/epic worktrees under os.tmpdir(), or a\n91\t * user-made one anywhere). Walks UP from cwd looking for a `.git` entry:\n92\t *   - `.git` is a FILE (linked worktree) whose first line is\n93\t *     `gitdir: <main>/.git/worktrees/<name>` → returns <main>.\n94\t *   - `.git` is a DIRECTORY (already the main tree) → returns that ancestor.\n95\t *   - nothing found within MAX_WORKTREE_WALK levels → returns null.\n96\t * Pure fs, synchronous, never throws — any unexpected shape (garbled file,\n97\t * unreadable entry, gitdir path without the worktrees marker) yields null so\n98\t * the caller leaves the cwd unchanged rather than guessing.\n99\t */\n100\tfunction worktreeMainRootOf(cwd) {\n101\t  let dir = cwd;\n102\t  for (let i = 0; i < MAX_WORKTREE_WALK; i++) {\n103\t    const gitPath = path.join(dir, '.git');\n104\t    let stat;\n105\t    try {\n106\t      stat = fs.statSync(gitPath);\n107\t    } catch {\n108\t      stat = null;\n109\t    }\n110\t    if (stat) {\n111\t      if (stat.isDirectory()) return dir;\n112\t      if (stat.isFile()) {\n113\t        let body;\n114\t        try {\n115\t          body = fs.readFileSync(gitPath, 'utf8');\n116\t        } catch {\n117\t          return null;\n118\t        }\n119\t        const firstLine = body.split('\\n', 1)[0].trim();\n120\t        const prefix = 'gitdir:';\n121\t        if (!firstLine.startsWith(prefix)) return null;\n122\t        const gitdir = firstLine.slice(prefix.length).trim();\n123\t        const markerIdx = gitdir.indexOf(WORKTREES_MARKER);\n124\t        if (markerIdx <= 0) return null;\n125\t        const candidateMain = gitdir.slice(0, markerIdx);\n126\t        const worktreeName = gitdir.slice(markerIdx + WORKTREES_MARKER.length).split(path.sep)[0];\n127\t        // Round-trip verification: gitdir's content is a plain file that\n128\t        // anything on disk could have written (e.g. a nested `.git` file\n129\t        // tracked inside an untrusted repo), so it must not be trusted to\n130\t        // redirect callers to an arbitrary attacker-chosen absolute path.\n131\t        // A genuine linked worktree's admin dir back-references the exact\n132\t        // `.git` FILE we are resolving via its own `gitdir` pointer file —\n133\t        // require that round trip before accepting candidateMain.\n134\t        if (!worktreeName) return null;\n135\t        const adminGitdirFile = path.join(candidateMain, '.git', 'worktrees', worktreeName, 'gitdir');\n136\t        let backRef;\n137\t        try {\n138\t          backRef = fs.readFileSync(adminGitdirFile, 'utf8').trim();\n139\t        } catch {\n140\t          return null;\n141\t        }\n142\t        if (path.resolve(backRef) !== path.resolve(gitPath)) return null;\n143\t        return candidateMain;\n144\t      }\n145\t      return null;\n146\t    }\n147\t    const parent = path.dirname(dir);\n148\t    if (parent === dir) return null;\n149\t    dir = parent;\n150\t  }\n151\t  return null;\n152\t}\n153\t\n154\t/**\n155\t * projectRootOf(cwd) → the project root for a cwd that may sit inside an ops\n156\t * tree and/or a linked git worktree. Returns cwd unchanged when neither\n157\t * applies. Only the FIRST ops-dir occurrence matters — a nested stray ops\n158\t * root is itself the bug, never a project. The ops-dir truncation runs\n159\t * first, then the worktree resolution, so a cwd deep inside a worktree's OWN\n160\t * ops tree still lands on the real project's main root.\n161\t */\n162\tfunction projectRootOf(cwd) {\n163\t  const parts = cwd.split(path.sep);\n164\t  const i = parts.indexOf(OPS_DIRNAME);\n165\t  const truncated = i > 0 ? (parts.slice(0, i).join(path.sep) || path.sep) : cwd;\n166\t  const mainRoot = worktreeMainRootOf(truncated);\n167\t  return mainRoot || truncated;\n168\t}\n169\t\n170\t/**\n171\t * readTailLines(filePath, maxBytes) → string[]\n172\t * Reads at most maxBytes from the END of filePath and splits into non-empty lines.\n173\t * O(1) in file size (bounded read). Returns [] on any I/O error.\n174\t */\n175\tfunction readTailLines(filePath, maxBytes) {\n176\t  let buf;\n177\t  try {\n178\t    const stat = fs.statSync(filePath);\n179\t    if (stat.size === 0) return [];\n180\t    const readSize = Math.min(maxBytes, stat.size);\n181\t    const fd = fs.openSync(filePath, 'r');\n182\t    try {\n183\t      buf = Buffer.alloc(readSize);\n184\t      fs.readSync(fd, buf, 0, readSize, stat.size - readSize);\n185\t    } finally {\n186\t      fs.closeSync(fd);\n187\t    }\n188\t  } catch {\n189\t    return [];\n190\t  }\n191\t  return buf.toString('utf8').split('\\n').filter((l) => l.trim());\n192\t}\n193\t\n194\t/**\n195\t * activeProjectCwds(maxAgeMin = 90, opts?) → string[]\n196\t *\n197\t * Returns distinct, on-disk project cwds that have an open/active session\n198\t * within the last maxAgeMin minutes.\n199\t *\n200\t * Sole detection path: scan ~/.claude/projects/*​/  for transcript *.jsonl\n201\t *   files modified within maxAgeMin, read `cwd` from the last parseable line\n202\t *   of the newest transcript per project dir.\n203\t *   Complexity: O(P × L) over P project dirs, each bounded-tail read (64 KB).\n204\t *\n205\t * opts (for testing):\n206\t *   projectsDir   — override the default ~/.claude/projects path\n207\t *   tmpDropRoots  — override the tmp guard's drop roots (default TMP_DROP_ROOTS)\n208\t */\n209\tfunction activeProjectCwds(maxAgeMin = 90, {\n210\t  projectsDir = path.join(HOME, '.claude', 'projects'),\n211\t  maxCwds = MAX_CWDS,\n212\t  tmpDropRoots = TMP_DROP_ROOTS,\n213\t} = {}) {\n214\t  const cacheKey = [projectsDir, maxAgeMin, maxCwds].join('|');\n215\t  let dirMtimeMs;\n216\t  try {\n217\t    dirMtimeMs = fs.statSync(projectsDir).mtimeMs;\n218\t  } catch {\n219\t    // Missing/unreadable dir: nothing to scan, and any prior cache entry for\n220\t    // this key must not survive to be handed back once the dir later\n221\t    // appears — drop it rather than caching this empty result.\n222\t    cwdScanCache.delete(cacheKey);\n223\t    return [];\n224\t  }\n225\t  const cached = cwdScanCache.get(cacheKey);\n226\t  const now0 = Date.now();\n227\t  if (cached && cached.dirMtimeMs === dirMtimeMs && now0 - cached.cachedAt < CACHE_TTL_MS) {\n228\t    return cached.result;\n229\t  }\n230\t\n231\t  // maxAgeMin === Infinity means \"every project ever seen, no recency filter\"\n232\t  // (allProjectCwds below). Date.now() - Infinity is -Infinity, which every\n233\t  // mtime clears — spelled out here because it reads like an accident.\n234\t  const cutoffMs = Date.now() - maxAgeMin * 60 * 1000;\n235\t  const seen = new Set();\n236\t  const result = [];\n237\t\n238\t  function addCwd(rawCwd) {\n239\t    if (!rawCwd || typeof rawCwd !== 'string') return;\n240\t    // Normalize an ops-internal cwd up to its project root BEFORE any of the\n241\t    // checks below — the stray-ops-root incident (see OPS_DIRNAME above) got\n242\t    // through precisely because such a path is absolute and does exist.\n243\t    const cwd = projectRootOf(rawCwd);\n244\t    // Must be ABSOLUTE. A relative fragment would pass the statSync below\n245\t    // whenever it happens to resolve against THIS process's own cwd, and\n246\t    // every consumer (queueStore.projectStateDir, prdLocations) then joins\n247\t    // it into an ops-root path that lands somewhere arbitrary. Callers key\n248\t    // whole per-project state off these strings — a project is a cwd, and a\n249\t    // cwd is an absolute path.\n250\t    if (!path.isAbsolute(cwd)) return;\n251\t    // Drop-guard of last resort: a cwd that is (or sits inside) a known\n252\t    // worktree-scratch root after projectRootOf's normalization is one\n253\t    // worktreeMainRootOf could not resolve to a main tree — never a real\n254\t    // project.\n255\t    if (tmpDropRoots.exactDropCwds.includes(cwd)) return;\n256\t    const isUnderPrefixDropRoot = tmpDropRoots.prefixDropRoots.some((root) => {\n257\t      if (cwd === root) return true;\n258\t      const rel = path.relative(root, cwd);\n259\t      return rel !== '' && !rel.startsWith('..') && !path.isAbsolute(rel);\n260\t    });\n261\t    if (isUnderPrefixDropRoot) return;\n262\t    if (seen.has(cwd) || result.length >= maxCwds) return;\n263\t    // Must exist AND be a directory — a transcript naming a since-deleted\n264\t    // path, or a file, is not a project.\n265\t    try { if (!fs.statSync(cwd).isDirectory()) return; } catch { return; }\n266\t    seen.add(cwd);\n267\t    result.push(cwd);\n268\t  }\n269\t\n270\t  // Scan ~/.claude/projects/*/  transcript *.jsonl files.\n271\t  let slugs;\n272\t  try { slugs = fs.readdirSync(projectsDir); } catch { cwdScanCache.delete(cacheKey); return result; }\n273\t\n274\t  for (const slug of slugs) {\n275\t    if (result.length >= maxCwds) break;\n276\t    const projDir = path.join(projectsDir, slug);\n277\t    let entries;\n278\t    try {\n279\t      entries = fs.readdirSync(projDir).filter((f) => f.endsWith('.jsonl'));\n280\t    } catch { continue; }\n281\t\n282\t    // Find the most recently modified transcript in this project dir.\n283\t    let newestPath = null;\n284\t    let newestMtimeMs = 0;\n285\t    for (const tf of entries) {\n286\t      const fp = path.join(projDir, tf);\n287\t      try {\n288\t        const st = fs.statSync(fp);\n289\t        if (st.mtimeMs > newestMtimeMs) {\n290\t          newestMtimeMs = st.mtimeMs;\n291\t          newestPath = fp;\n292\t        }\n293\t      } catch { continue; }\n294\t    }\n295\t\n296\t    if (!newestPath || newestMtimeMs < cutoffMs) continue;\n297\t\n298\t    // Read `cwd` from the last parseable line of the transcript.\n299\t    const tlines = readTailLines(newestPath, TAIL_BYTES);\n300\t    for (let i = tlines.length - 1; i >= 0; i--) {\n301\t      let row;\n302\t      try { row = JSON.parse(tlines[i]); } catch { continue; }\n303\t      if (row.cwd) { addCwd(row.cwd); break; }\n304\t    }\n305\t  }\n306\t\n307\t  cwdScanCache.set(cacheKey, { dirMtimeMs, cachedAt: now0, result });\n308\t  return result;\n309\t}\n310\t\n311\t/**\n312\t * allProjectCwds(opts?) → string[]\n313\t *\n314\t * Every project cwd this machine has ever opened a Claude session in, with NO\n315\t * recency filter — the same transcript scan, minus the cutoff.\n316\t *\n317\t * Recency is the right question for \"which projects should I sweep for new\n318\t * feedback\". It is the WRONG question for \"which projects own PRDs\": a\n319\t * project that has been quiet for 90 minutes still owns its queued work, and\n320\t * treating its PRD dir as non-existent makes reconcile() read absence as\n321\t * deletion. (2026-07-31: 142 PRDs across 6 quiet projects went unscannable.)\n322\t *\n323\t * The cap is raised well above activeProjectCwds' 50 because this list is\n324\t * historical rather than \"currently in flight\".\n325\t */\n326\tfunction allProjectCwds(opts = {}) {\n327\t  return activeProjectCwds(Infinity, { maxCwds: 500, ...opts });\n328\t}\n329\t\n330\tmodule.exports = {\n331\t  activeProjectCwds,\n332\t  allProjectCwds,\n333\t  projectRootOf,\n334\t  worktreeMainRootOf,\n335\t  bustProjectCwdCache,\n336\t};\n337\t"}]},"parent_tool_use_id":null,"session_id":"5075ff69-e35d-4ac7-b38b-bfa9cd8abf1c","uuid":"c1835bd6-ddd6-4a4a-a110-2a9b91e3b2c9","timestamp":"2026-09-13T21:54:03.646Z","tool_use_result":{"type":"text","file":{"filePath":"/home/bilko/Projects/session-manager/scripts/lib/activeSessions.cjs","content":"'use strict';\n\n// activeSessions.cjs — returns distinct on-disk project cwds with an active\n// session within maxAgeMin minutes. Used by the feedback sweep (PRD 102) to\n// narrow scanning to projects the user is actually working in.\n//\n// Detection is transcript-based only (scans ~/.claude/projects/*/*.jsonl\n// mtimes). It has zero dependency on ~/.claude/knowledge-log/prompts.jsonl,\n// which PRD 356-retire purges along with its capture hook.\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\nconst { KIND_CONFIG: WORKTREE_KIND_CONFIG } = require('../../src/main/lib/gitWorktree.cjs');\n\nconst HOME = os.homedir();\nconst TMPDIR = os.tmpdir();\n\n// The last-resort drop targets for addCwd's tmp guard.\n//   - exactDropCwds: dropped only on an EXACT match — os.tmpdir() itself\n//     (e.g. `/tmp`). NOT a prefix match: this codebase's own test suite\n//     routinely stubs HOME to a tmp dir and nests a fake project cwd\n//     underneath it, a legitimate, unrelated use of os.tmpdir() that a\n//     blanket prefix match would wrongly drop.\n//   - prefixDropRoots: dropped on an exact match OR any nested path — the two\n//     managed worktree roots (both live under os.tmpdir() per gitWorktree\n//     .cjs's KIND_CONFIG). Nothing but managed worktree checkouts is ever\n//     created under these roots, so a prefix match here is safe. A resolvable\n//     worktree (managed or user-made, anywhere on disk) is already handled by\n//     worktreeMainRootOf above; this guard only catches what that resolution\n//     could not — e.g. a bare, .git-less worktree-root directory.\nconst TMP_DROP_ROOTS = {\n  exactDropCwds: [TMPDIR],\n  prefixDropRoots: [WORKTREE_KIND_CONFIG.job.root, WORKTREE_KIND_CONFIG.epic.root],\n};\n\n// Transcript reads only need the last line with a `cwd` field — a few dozen\n// lines is always enough. 64 KB keeps peak RSS proportionate.\nconst TAIL_BYTES = 64 * 1024;\n\n// Safety cap on distinct cwds to bound result set size. O(1) extra space.\nconst MAX_CWDS = 50;\n\n// activeProjectCwds' scan is a readdirSync of every dir under ~/.claude\n// /projects (2209 dirs / 8.8 GB observed) plus a statSync per transcript —\n// ~270 ms warm. reconcile() calls into it (directly or via allProjectCwds)\n// several times per pass, so cache the resolved cwd list keyed on the\n// resolved argument TUPLE (projectsDir, maxAgeMin, maxCwds) — never on\n// `!opts`, since allProjectCwds always constructs an options object and that\n// guard would cache nothing on the hottest path.\n//\n// Invalidation: projectsDir's own mtime (bumps when a project DIRECTORY is\n// added/removed — NOT when an existing transcript gains a line, which is\n// fine: a project already in the list stays in the list) plus a short TTL\n// as the backstop for everything else. Same mtime-keyed idiom as\n// scheduler/prdParser.cjs's dirCache and queueHistory.cjs's historyCacheKey.\nconst CACHE_TTL_MS = 30_000;\nconst cwdScanCache = new Map(); // key -> { dirMtimeMs, cachedAt, result }\n\n/** Forces the next activeProjectCwds/allProjectCwds call to rescan. */\nfunction bustProjectCwdCache() {\n  cwdScanCache.clear();\n}\n\n// The ops-root folder name. A transcript's `cwd` can point INSIDE it whenever\n// an agent `cd`s into an artifact directory (a PRD folder, prompt-sessions,\n// scheduler/state) — Claude Code records the new absolute cwd on every\n// subsequent row, and this scan reads the LAST such row. Left unnormalized,\n// that subdirectory is handed to consumers as if it were a project, and\n// queueStore.writeSplit materializes a whole second ops root beneath it:\n// `<project>/session-manager-operations/scheduler/epics/<id>/prds/session-\n// manager-operations/scheduler/state/queue.json`, holding `{\"jobs\": []}`.\n// Observed live on 2026-08-30 in starry-night-ships: 14 such stubs, mtimes\n// spanning 8 days, one per directory an agent had cd'd into.\n//\n// Truncating at the segment is strictly better than dropping the row: the\n// ancestor IS the project the agent was working in, so the active-project\n// signal survives instead of being silently lost.\nconst OPS_DIRNAME = 'session-manager-operations';\n\n// Bound on the ancestor walk in worktreeMainRootOf — well past any real\n// filesystem depth, purely to guarantee termination without relying on\n// reaching '/' (e.g. a symlink loop or an unusually deep path).\nconst MAX_WORKTREE_WALK = 40;\n\nconst WORKTREES_MARKER = `${path.sep}.git${path.sep}worktrees${path.sep}`;\n\n/**\n * worktreeMainRootOf(cwd) → the main tree's root when cwd sits inside a\n * linked `git worktree` (job/epic worktrees under os.tmpdir(), or a\n * user-made one anywhere). Walks UP from cwd looking for a `.git` entry:\n *   - `.git` is a FILE (linked worktree) whose first line is\n *     `gitdir: <main>/.git/worktrees/<name>` → returns <main>.\n *   - `.git` is a DIRECTORY (already the main tree) → returns that ancestor.\n *   - nothing found within MAX_WORKTREE_WALK levels → returns null.\n * Pure fs, synchronous, never throws — any unexpected shape (garbled file,\n * unreadable entry, gitdir path without the worktrees marker) yields null so\n * the caller leaves the cwd unchanged rather than guessing.\n */\nfunction worktreeMainRootOf(cwd) {\n  let dir = cwd;\n  for (let i = 0; i < MAX_WORKTREE_WALK; i++) {\n    const gitPath = path.join(dir, '.git');\n    let stat;\n    try {\n      stat = fs.statSync(gitPath);\n    } catch {\n      stat = null;\n    }\n    if (stat) {\n      if (stat.isDirectory()) return dir;\n      if (stat.isFile()) {\n        let body;\n        try {\n          body = fs.readFileSync(gitPath, 'utf8');\n        } catch {\n          return null;\n        }\n        const firstLine = body.split('\\n', 1)[0].trim();\n        const prefix = 'gitdir:';\n        if (!firstLine.startsWith(prefix)) return null;\n        const gitdir = firstLine.slice(prefix.length).trim();\n        const markerIdx = gitdir.indexOf(WORKTREES_MARKER);\n        if (markerIdx <= 0) return null;\n        const candidateMain = gitdir.slice(0, markerIdx);\n        const worktreeName = gitdir.slice(markerIdx + WORKTREES_MARKER.length).split(path.sep)[0];\n        // Round-trip verification: gitdir's content is a plain file that\n        // anything on disk could have written (e.g. a nested `.git` file\n        // tracked inside an untrusted repo), so it must not be trusted to\n        // redirect callers to an arbitrary attacker-chosen absolute path.\n        // A genuine linked worktree's admin dir back-references the exact\n        // `.git` FILE we are resolving via its own `gitdir` pointer file —\n        // require that round trip before accepting candidateMain.\n        if (!worktreeName) return null;\n        const adminGitdirFile = path.join(candidateMain, '.git', 'worktrees', worktreeName, 'gitdir');\n        let backRef;\n        try {\n          backRef = fs.readFileSync(adminGitdirFile, 'utf8').trim();\n        } catch {\n          return null;\n        }\n        if (path.resolve(backRef) !== path.resolve(gitPath)) return null;\n        return candidateMain;\n      }\n      return null;\n    }\n    const parent = path.dirname(dir);\n    if (parent === dir) return null;\n    dir = parent;\n  }\n  return null;\n}\n\n/**\n * projectRootOf(cwd) → the project root for a cwd that may sit inside an ops\n * tree and/or a linked git worktree. Returns cwd unchanged when neither\n * applies. Only the FIRST ops-dir occurrence matters — a nested stray ops\n * root is itself the bug, never a project. The ops-dir truncation runs\n * first, then the worktree resolution, so a cwd deep inside a worktree's OWN\n * ops tree still lands on the real project's main root.\n */\nfunction projectRootOf(cwd) {\n  const parts = cwd.split(path.sep);\n  const i = parts.indexOf(OPS_DIRNAME);\n  const truncated = i > 0 ? (parts.slice(0, i).join(path.sep) || path.sep) : cwd;\n  const mainRoot = worktreeMainRootOf(truncated);\n  return mainRoot || truncated;\n}\n\n/**\n * readTailLines(filePath, maxBytes) → string[]\n * Reads at most maxBytes from the END of filePath and splits into non-empty lines.\n * O(1) in file size (bounded read). Returns [] on any I/O error.\n */\nfunction readTailLines(filePath, maxBytes) {\n  let buf;\n  try {\n    const stat = fs.statSync(filePath);\n    if (stat.size === 0) return [];\n    const readSize = Math.min(maxBytes, stat.size);\n    const fd = fs.openSync(filePath, 'r');\n    try {\n      buf = Buffer.alloc(readSize);\n      fs.readSync(fd, buf, 0, readSize, stat.size - readSize);\n    } finally {\n      fs.closeSync(fd);\n    }\n  } catch {\n    return [];\n  }\n  return buf.toString('utf8').split('\\n').filter((l) => l.trim());\n}\n\n/**\n * activeProjectCwds(maxAgeMin = 90, opts?) → string[]\n *\n * Returns distinct, on-disk project cwds that have an open/active session\n * within the last maxAgeMin minutes.\n *\n * Sole detection path: scan ~/.claude/projects/*​/  for transcript *.jsonl\n *   files modified within maxAgeMin, read `cwd` from the last parseable line\n *   of the newest transcript per project dir.\n *   Complexity: O(P × L) over P project dirs, each bounded-tail read (64 KB).\n *\n * opts (for testing):\n *   projectsDir   — override the default ~/.claude/projects path\n *   tmpDropRoots  — override the tmp guard's drop roots (default TMP_DROP_ROOTS)\n */\nfunction activeProjectCwds(maxAgeMin = 90, {\n  projectsDir = path.join(HOME, '.claude', 'projects'),\n  maxCwds = MAX_CWDS,\n  tmpDropRoots = TMP_DROP_ROOTS,\n} = {}) {\n  const cacheKey = [projectsDir, maxAgeMin, maxCwds].join('|');\n  let dirMtimeMs;\n  try {\n    dirMtimeMs = fs.statSync(projectsDir).mtimeMs;\n  } catch {\n    // Missing/unreadable dir: nothing to scan, and any prior cache entry for\n    // this key must not survive to be handed back once the dir later\n    // appears — drop it rather than caching this empty result.\n    cwdScanCache.delete(cacheKey);\n    return [];\n  }\n  const cached = cwdScanCache.get(cacheKey);\n  const now0 = Date.now();\n  if (cached && cached.dirMtimeMs === dirMtimeMs && now0 - cached.cachedAt < CACHE_TTL_MS) {\n    return cached.result;\n  }\n\n  // maxAgeMin === Infinity means \"every project ever seen, no recency filter\"\n  // (allProjectCwds below). Date.now() - Infinity is -Infinity, which every\n  // mtime clears — spelled out here because it reads like an accident.\n  const cutoffMs = Date.now() - maxAgeMin * 60 * 1000;\n  const seen = new Set();\n  const result = [];\n\n  function addCwd(rawCwd) {\n    if (!rawCwd || typeof rawCwd !== 'string') return;\n    // Normalize an ops-internal cwd up to its project root BEFORE any of the\n    // checks below — the stray-ops-root incident (see OPS_DIRNAME above) got\n    // through precisely because such a path is absolute and does exist.\n    const cwd = projectRootOf(rawCwd);\n    // Must be ABSOLUTE. A relative fragment would pass the statSync below\n    // whenever it happens to resolve against THIS process's own cwd, and\n    // every consumer (queueStore.projectStateDir, prdLocations) then joins\n    // it into an ops-root path that lands somewhere arbitrary. Callers key\n    // whole per-project state off these strings — a project is a cwd, and a\n    // cwd is an absolute path.\n    if (!path.isAbsolute(cwd)) return;\n    // Drop-guard of last resort: a cwd that is (or sits inside) a known\n    // worktree-scratch root after projectRootOf's normalization is one\n    // worktreeMainRootOf could not resolve to a main tree — never a real\n    // project.\n    if (tmpDropRoots.exactDropCwds.includes(cwd)) return;\n    const isUnderPrefixDropRoot = tmpDropRoots.prefixDropRoots.some((root) => {\n      if (cwd === root) return true;\n      const rel = path.relative(root, cwd);\n      return rel !== '' && !rel.startsWith('..') && !path.isAbsolute(rel);\n    });\n    if (isUnderPrefixDropRoot) return;\n    if (seen.has(cwd) || result.length >= maxCwds) return;\n    // Must exist AND be a directory — a transcript naming a since-deleted\n    // path, or a file, is not a project.\n    try { if (!fs.statSync(cwd).isDirectory()) return; } catch { return; }\n    seen.add(cwd);\n    result.push(cwd);\n  }\n\n  // Scan ~/.claude/projects/*/  transcript *.jsonl files.\n  let slugs;\n  try { slugs = fs.readdirSync(projectsDir); } catch { cwdScanCache.delete(cacheKey); return result; }\n\n  for (const slug of slugs) {\n    if (result.length >= maxCwds) break;\n    const projDir = path.join(projectsDir, slug);\n    let entries;\n    try {\n      entries = fs.readdirSync(projDir).filter((f) => f.endsWith('.jsonl'));\n    } catch { continue; }\n\n    // Find the most recently modified transcript in this project dir.\n    let newestPath = null;\n    let newestMtimeMs = 0;\n    for (const tf of entries) {\n      const fp = path.join(projDir, tf);\n      try {\n        const st = fs.statSync(fp);\n        if (st.mtimeMs > newestMtimeMs) {\n          newestMtimeMs = st.mtimeMs;\n          newestPath = fp;\n        }\n      } catch { continue; }\n    }\n\n    if (!newestPath || newestMtimeMs < cutoffMs) continue;\n\n    // Read `cwd` from the last parseable line of the transcript.\n    const tlines = readTailLines(newestPath, TAIL_BYTES);\n    for (let i = tlines.length - 1; i >= 0; i--) {\n      let row;\n      try { row = JSON.parse(tlines[i]); } catch { continue; }\n      if (row.cwd) { addCwd(row.cwd); break; }\n    }\n  }\n\n  cwdScanCache.set(cacheKey, { dirMtimeMs, cachedAt: now0, result });\n  return result;\n}\n\n/**\n * allProjectCwds(opts?) → string[]\n *\n * Every project cwd this machine has ever opened a Claude session in, with NO\n * recency filter — the same transcript scan, minus the cutoff.\n *\n * Recency is the right question for \"which projects should I sweep for new\n * feedback\". It is the WRONG question for \"which projects own PRDs\": a\n * project that has been quiet for 90 minutes still owns its queued work, and\n * treating its PRD dir as non-existent makes reconcile() read absence as\n * deletion. (2026-07-31: 142 PRDs across 6 quiet projects went unscannable.)\n *\n * The cap is raised well above activeProjectCwds' 50 because this list is\n * historical rather than \"currently in flight\".\n */\nfunction allProjectCwds(opts = {}) {\n  return activeProjectCwds(Infinity, { maxCwds: 500, ...opts });\n}\n\nmodule.exports = {\n  activeProjectCwds,\n  allProjectCwds,\n  projectRootOf,\n  worktreeMainRootOf,\n  bustProjectCwdCache,\n};\n","numLines":337,"startLine":1,"totalLines":337}}}
