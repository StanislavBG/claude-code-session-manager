{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019VDkvbsjC8oKnPVSuQV81S","type":"tool_result","content":"1\t'use strict';\n2\t\n3\t// watchdogHelpers.cjs — pure helpers for scheduler-watchdog.cjs (no side effects).\n4\t// Testable without spawning the watchdog entry script.\n5\t\n6\tconst fs = require('node:fs');\n7\tconst os = require('node:os');\n8\tconst path = require('node:path');\n9\t\n10\t\n11\t// Mirrors scheduler.cjs:215 (single source of truth there; kept in sync here).\n12\tconst DEFAULT_HEARTBEAT_PATH = path.join(\n13\t  os.homedir(), '.claude', 'session-manager', 'scheduler-heartbeat.log',\n14\t);\n15\t\n16\t// The in-app heartbeat ticks every 60 s; 3 missed ticks = stale.\n17\tconst DEFAULT_MAX_AGE_MS = 180_000;\n18\t\n19\t/** Local-TZ 'YYYY-MM-DD' for `d` (default now). Single source of truth for\n20\t *  the watchdog's notion of \"today\" — used for both the log filename and the\n21\t *  history-rollup once-per-day gate. */\n22\tfunction localDateStr(d = new Date()) {\n23\t  const y = d.getFullYear();\n24\t  const m = String(d.getMonth() + 1).padStart(2, '0');\n25\t  const day = String(d.getDate()).padStart(2, '0');\n26\t  return `${y}-${m}-${day}`;\n27\t}\n28\t\n29\t// Tail bytes to read — enough to hold several JSON heartbeat lines without\n30\t// loading a potentially 1 MB file. O(1) in file size.\n31\tconst TAIL_BYTES = 4096;\n32\t\n33\t/**\n34\t * readLastHeartbeat(heartbeatPath?) → object | null\n35\t *\n36\t * Reads the last ~4 KB of the heartbeat log, reverse-scans for the last\n37\t * non-empty line, and returns the full parsed JSON object.\n38\t * Returns null on missing / empty / unparseable file.\n39\t *\n40\t * Single source of truth for the file-read + reverse-scan logic; used by\n41\t * readLastHeartbeatTs() and heartbeatFresh().\n42\t */\n43\tfunction readLastHeartbeat(heartbeatPath = DEFAULT_HEARTBEAT_PATH) {\n44\t  let buf;\n45\t  try {\n46\t    const stat = fs.statSync(heartbeatPath);\n47\t    const size = stat.size;\n48\t    if (size === 0) return null;\n49\t\n50\t    const readSize = Math.min(TAIL_BYTES, size);\n51\t    const fd = fs.openSync(heartbeatPath, 'r');\n52\t    try {\n53\t      buf = Buffer.alloc(readSize);\n54\t      fs.readSync(fd, buf, 0, readSize, size - readSize);\n55\t    } finally {\n56\t      fs.closeSync(fd);\n57\t    }\n58\t  } catch {\n59\t    return null;\n60\t  }\n61\t\n62\t  const lines = buf.toString('utf8').split('\\n');\n63\t  // Walk lines in reverse to find last non-empty parseable one.\n64\t  for (let i = lines.length - 1; i >= 0; i--) {\n65\t    const line = lines[i].trim();\n66\t    if (!line) continue;\n67\t    try {\n68\t      return JSON.parse(line);\n69\t    } catch {\n70\t      return null;\n71\t    }\n72\t  }\n73\t  return null;\n74\t}\n75\t\n76\t/**\n77\t * readLastHeartbeatTs(heartbeatPath?) → number | null\n78\t *\n79\t * Returns the `ts` field (epoch ms) from the last heartbeat entry.\n80\t * Returns null on missing / empty / unparseable file or missing ts field.\n81\t */\n82\tfunction readLastHeartbeatTs(heartbeatPath = DEFAULT_HEARTBEAT_PATH) {\n83\t  const entry = readLastHeartbeat(heartbeatPath);\n84\t  return (entry !== null && typeof entry.ts === 'number') ? entry.ts : null;\n85\t}\n86\t\n87\t/**\n88\t * heartbeatFresh(heartbeatPath?, maxAgeMs?) → boolean\n89\t *\n90\t * Returns true iff the last heartbeat ts is within maxAgeMs of `now`.\n91\t * Missing / empty / unparseable file → false.\n92\t */\n93\tfunction heartbeatFresh(heartbeatPath = DEFAULT_HEARTBEAT_PATH, maxAgeMs = DEFAULT_MAX_AGE_MS) {\n94\t  const ts = readLastHeartbeatTs(heartbeatPath);\n95\t  if (ts === null) return false;\n96\t  return (Date.now() - ts) < maxAgeMs;\n97\t}\n98\t\n99\t/**\n100\t * isPidAlive(pid) → boolean\n101\t *\n102\t * Plain liveness check via process.kill(pid, 0) (no signal sent). Single\n103\t * source of truth for the \"is this recorded pid still alive\" check used by\n104\t * checkAppLiveness's defense-in-depth relaunch gate.\n105\t *\n106\t * EPERM (pid exists, owned by another user) counts as alive — only ESRCH\n107\t * (no such process) means dead. Watchdog and app run as the same user in\n108\t * practice, so this distinction rarely matters here, but treating EPERM as\n109\t * \"dead\" would be wrong on its face (the process demonstrably exists).\n110\t */\n111\tfunction isPidAlive(pid) {\n112\t  if (typeof pid !== 'number' || !Number.isFinite(pid)) return false;\n113\t  try {\n114\t    process.kill(pid, 0);\n115\t    return true;\n116\t  } catch (e) {\n117\t    return e?.code === 'EPERM';\n118\t  }\n119\t}\n120\t\n121\t// Offline queue.json reconciliation (orphaned 'running' jobs whose pid died\n122\t// while Electron wasn't running) used to live here as reconcileQueueOffline().\n123\t// PRD 686 moved that responsibility into src/main/scheduler.cjs's own boot\n124\t// path (partitionBootOrphans/applyOrphanOutcome) now that PRD 685's watchdog\n125\t// relaunch means the app is never down long enough to need an external\n126\t// reconciler — the in-app scheduler is queue.json's single owner again.\n127\t\n128\t// ── app liveness + auto-relaunch ─────────────────────────────────────────────\n129\t//\n130\t// The watchdog's one supervision job: is session-manager itself running, and\n131\t// if not, start it. Reuses the existing scheduler heartbeat (written every\n132\t// 60 s by scheduler.cjs's heartbeatInterval regardless of pause state) as the\n133\t// liveness signal — no second heartbeat file.\n134\t\n135\tconst DEFAULT_RELAUNCH_STATE_PATH = path.join(\n136\t  os.homedir(), '.claude', 'session-manager', 'watchdog-relaunch-state.json',\n137\t);\n138\tconst DEFAULT_RELAUNCH_LOG_PATH = path.join(\n139\t  os.homedir(), '.claude', 'logs', 'scheduler-watchdog-relaunch.log',\n140\t);\n141\tconst DEFAULT_RELAUNCH_DEBOUNCE_MS = 90_000;\n142\tconst DEFAULT_MAX_RELAUNCH_ATTEMPTS = 3;\n143\t\n144\t/**\n145\t * checkAppLiveness(opts?) → { alive: boolean, reason: string }\n146\t *\n147\t * Primary signal: heartbeatFresh() within the existing max-age window.\n148\t * Defense-in-depth: if the heartbeat is stale, but the pid it last recorded\n149\t * is still alive (app under heavy load, tick just missed), treat as alive\n150\t * rather than relaunching on top of a live process.\n151\t */\n152\tfunction checkAppLiveness({\n153\t  heartbeatPath = DEFAULT_HEARTBEAT_PATH,\n154\t  maxAgeMs = DEFAULT_MAX_AGE_MS,\n155\t} = {}) {\n156\t  if (heartbeatFresh(heartbeatPath, maxAgeMs)) {\n157\t    return { alive: true, reason: 'heartbeat-fresh' };\n158\t  }\n159\t  const last = readLastHeartbeat(heartbeatPath);\n160\t  if (last !== null && typeof last.pid === 'number' && isPidAlive(last.pid)) {\n161\t    return { alive: true, reason: 'pid-alive-heartbeat-stale' };\n162\t  }\n163\t  return { alive: false, reason: 'stale-and-dead' };\n164\t}\n165\t\n166\t/** Default { lastAttemptTs: null, attemptCount: 0 } on missing/unparseable state file. */\n167\tfunction readRelaunchState(statePath = DEFAULT_RELAUNCH_STATE_PATH) {\n168\t  try {\n169\t    const raw = JSON.parse(fs.readFileSync(statePath, 'utf8'));\n170\t    return {\n171\t      lastAttemptTs: typeof raw.lastAttemptTs === 'number' ? raw.lastAttemptTs : null,\n172\t      attemptCount: typeof raw.attemptCount === 'number' ? raw.attemptCount : 0,\n173\t    };\n174\t  } catch {\n175\t    return { lastAttemptTs: null, attemptCount: 0 };\n176\t  }\n177\t}\n178\t\n179\t/** Atomic write: tmp-<pid>-<ts> → rename (mirrors config.cjs writeJsonSync). */\n180\tfunction writeRelaunchState(statePath, state) {\n181\t  fs.mkdirSync(path.dirname(statePath), { recursive: true });\n182\t  const tmpPath = `${statePath}.tmp-${process.pid}-${Date.now()}`;\n183\t  fs.writeFileSync(tmpPath, JSON.stringify(state, null, 2) + '\\n', 'utf8');\n184\t  fs.renameSync(tmpPath, statePath);\n185\t}\n186\t\n187\tfunction logRelaunchLine(logPath, message) {\n188\t  try {\n189\t    fs.mkdirSync(path.dirname(logPath), { recursive: true });\n190\t    fs.appendFileSync(logPath, `${new Date().toISOString()} ${message}\\n`);\n191\t  } catch (e) {\n192\t    process.stderr.write(`[watchdog-relaunch] log write failed: ${e?.message}\\n`);\n193\t  }\n194\t}\n195\t\n196\t/**\n197\t * defaultSpawnRelaunch(opts?) — launches a new session-manager instance the\n198\t * same way a user would: `npx claude-code-session-manager@latest` (the\n199\t * documented distribution method — CLAUDE.md's \"Distribution\" section), so\n200\t * this keeps working across npm publishes with no local path to maintain.\n201\t *\n202\t * Detached + stdio redirected to logPath + unref()'d so the watchdog's own\n203\t * (short-lived) process doesn't block on the launched app and the app\n204\t * survives the watchdog exiting.\n205\t */\n206\tfunction defaultSpawnRelaunch({ logPath = DEFAULT_RELAUNCH_LOG_PATH } = {}) {\n207\t  const { spawn } = require('node:child_process');\n208\t  fs.mkdirSync(path.dirname(logPath), { recursive: true });\n209\t  const fd = fs.openSync(logPath, 'a');\n210\t  try {\n211\t    const child = spawn('npx', ['claude-code-session-manager@latest'], {\n212\t      detached: true,\n213\t      stdio: ['ignore', fd, fd],\n214\t    });\n215\t    child.on('error', (e) => {\n216\t      logRelaunchLine(logPath, `spawn error: ${e?.message}`);\n217\t    });\n218\t    child.unref();\n219\t  } finally {\n220\t    fs.closeSync(fd);\n221\t  }\n222\t}\n223\t\n224\t/**\n225\t * maybeRelaunchApp(opts?) → { relaunched: boolean, reason: string, attemptCount: number }\n226\t *\n227\t * Debounced, capped auto-relaunch:\n228\t *   - alive (heartbeat fresh or pid alive)             → no-op, reset attempt state.\n229\t *   - dead + attemptCount already at maxAttempts         → skip, log diagnostic (give up).\n230\t *   - dead + last attempt < debounceMs ago                → skip (still booting).\n231\t *   - dead + debounce elapsed + under cap               → spawn, bump attemptCount, log.\n232\t *\n233\t * attemptCount only resets to 0 once a fresh heartbeat is observed (i.e. a\n234\t * relaunch actually succeeded), so 3 relaunch attempts that each fail to\n235\t * produce a fresh heartbeat permanently cap further attempts until a human\n236\t * intervenes or the app comes up some other way.\n237\t */\n238\tfunction maybeRelaunchApp({\n239\t  heartbeatPath = DEFAULT_HEARTBEAT_PATH,\n240\t  maxAgeMs = DEFAULT_MAX_AGE_MS,\n241\t  statePath = DEFAULT_RELAUNCH_STATE_PATH,\n242\t  logPath = DEFAULT_RELAUNCH_LOG_PATH,\n243\t  debounceMs = DEFAULT_RELAUNCH_DEBOUNCE_MS,\n244\t  maxAttempts = DEFAULT_MAX_RELAUNCH_ATTEMPTS,\n245\t  now = Date.now(),\n246\t  spawnFn = defaultSpawnRelaunch,\n247\t} = {}) {\n248\t  const liveness = checkAppLiveness({ heartbeatPath, maxAgeMs });\n249\t  const state = readRelaunchState(statePath);\n250\t\n251\t  if (liveness.alive) {\n252\t    if (state.attemptCount !== 0 || state.lastAttemptTs !== null) {\n253\t      writeRelaunchState(statePath, { lastAttemptTs: null, attemptCount: 0 });\n254\t    }\n255\t    return { relaunched: false, reason: 'alive', attemptCount: 0 };\n256\t  }\n257\t\n258\t  if (state.attemptCount >= maxAttempts) {\n259\t    logRelaunchLine(\n260\t      logPath,\n261\t      `giving up: ${state.attemptCount} relaunch attempt(s) already made and heartbeat is still stale — manual intervention required`,\n262\t    );\n263\t    return { relaunched: false, reason: 'capped', attemptCount: state.attemptCount };\n264\t  }\n265\t\n266\t  if (state.lastAttemptTs !== null && (now - state.lastAttemptTs) < debounceMs) {\n267\t    return { relaunched: false, reason: 'debounce', attemptCount: state.attemptCount };\n268\t  }\n269\t\n270\t  const attemptCount = state.attemptCount + 1;\n271\t  spawnFn({ logPath });\n272\t  writeRelaunchState(statePath, { lastAttemptTs: now, attemptCount });\n273\t  logRelaunchLine(\n274\t    logPath,\n275\t    `relaunch attempt ${attemptCount}/${maxAttempts}: spawning \"npx claude-code-session-manager@latest\" (heartbeat stale, last-known pid dead)`,\n276\t  );\n277\t  return { relaunched: true, reason: 'launched', attemptCount };\n278\t}\n279\t\n280\t// ── maybeFinalizeHistory ─────────────────────────────────────────────────────\n281\t//\n282\t// Precomputes closed History-dashboard days outside Electron, so the app's\n283\t// first paint after a boot (possibly weeks after the app was last open) is\n284\t// instant, and old transcripts stay safe to age out without losing analytics.\n285\t// See src/main/historyAggregator.cjs's finalizeClosedDays() for the actual\n286\t// walk/persist logic — this is just the once-per-day scheduling + lock\n287\t// wrapper around it, tailored to being invoked repeatedly by a systemd timer.\n288\t\n289\tconst DEFAULT_STAMP_PATH = path.join(\n290\t  os.homedir(), '.claude', 'session-manager', 'history-rollup.stamp',\n291\t);\n292\tconst DEFAULT_LOCK_PATH = path.join(\n293\t  os.homedir(), '.claude', 'session-manager', 'history-rollup.lock',\n294\t);\n295\tconst DEFAULT_LOCK_STALE_MS = 10 * 60 * 1000; // 10 min\n296\tconst DEFAULT_FINALIZE_BUDGET_MS = 60_000;\n297\t\n298\tfunction readStampDate(stampPath) {\n299\t  try {\n300\t    return fs.readFileSync(stampPath, 'utf8').trim();\n301\t  } catch {\n302\t    return null;\n303\t  }\n304\t}\n305\t\n306\t/** Atomic write: tmp-<pid>-<ts> → rename (mirrors config.cjs writeJsonSync). */\n307\tfunction writeStampDate(stampPath, date) {\n308\t  fs.mkdirSync(path.dirname(stampPath), { recursive: true });\n309\t  const tmpPath = `${stampPath}.tmp-${process.pid}-${Date.now()}`;\n310\t  fs.writeFileSync(tmpPath, date, 'utf8');\n311\t  fs.renameSync(tmpPath, stampPath);\n312\t}\n313\t\n314\t/**\n315\t * tryAcquireLock(lockPath, staleMs) → boolean\n316\t *\n317\t * O_EXCL ('wx') lock file so the in-app Electron boot pass and this cron\n318\t * pass never interleave writes to the rollup. A lock older than staleMs is\n319\t * assumed abandoned (a crashed holder) and reclaimed; otherwise the caller\n320\t * loses the race and must skip silently.\n321\t */\n322\tfunction tryAcquireLock(lockPath, staleMs = DEFAULT_LOCK_STALE_MS) {\n323\t  fs.mkdirSync(path.dirname(lockPath), { recursive: true });\n324\t  try {\n325\t    fs.writeFileSync(lockPath, String(process.pid), { flag: 'wx' });\n326\t    return true;\n327\t  } catch (e) {\n328\t    if (e.code !== 'EEXIST') throw e;\n329\t  }\n330\t\n331\t  let st;\n332\t  try {\n333\t    st = fs.statSync(lockPath);\n334\t  } catch {\n335\t    st = null; // lock vanished between our failed create and this stat\n336\t  }\n337\t\n338\t  if (st !== null && Date.now() - st.mtimeMs <= staleMs) {\n339\t    return false; // held by a live (or at least recent) owner — loser skips\n340\t  }\n341\t\n342\t  // Stale (or already gone) — reclaim. The unlink+wx pair isn't atomic, so\n343\t  // two concurrent reclaimers could theoretically both win here — but that\n344\t  // only happens when the prior holder already crashed/vanished, and the\n345\t  // resulting \"both run finalize\" outcome is benign: appendRollupDays is\n346\t  // append-only + last-write-wins-deduped, so a redundant concurrent pass\n347\t  // costs extra work, not corrupted data.\n348\t  try {\n349\t    if (st !== null) fs.unlinkSync(lockPath);\n350\t    fs.writeFileSync(lockPath, String(process.pid), { flag: 'wx' });\n351\t    return true;\n352\t  } catch {\n353\t    return false;\n354\t  }\n355\t}\n356\t\n357\tfunction releaseLock(lockPath) {\n358\t  try { fs.unlinkSync(lockPath); } catch { /* already gone / never created */ }\n359\t}\n360\t\n361\t/** Lazily require historyAggregator.cjs — deferred so a missing PRD-650\n362\t *  dependency fails inside maybeFinalizeHistory's try/catch, not at require\n363\t *  time for the whole watchdog script. */\n364\tfunction defaultFinalizeClosedDays(opts) {\n365\t  const { finalizeClosedDays } = require('../../src/main/historyAggregator.cjs');\n366\t  return finalizeClosedDays(opts);\n367\t}\n368\t\n369\t/**\n370\t * maybeFinalizeHistory(opts?) → Promise<{ ran, reason, date, finalizedDates? }>\n371\t *\n372\t * Runs at most once per local day (stamp-file gated, O(1) same-day skip).\n373\t * Guards against interleaving with the in-app Electron boot pass via an\n374\t * O_EXCL lock file. Bounded by opts.budgetMs so a huge transcript corpus\n375\t * can't make a single watchdog tick run long; a budget-partial pass does\n376\t * NOT stamp the day complete, so a later tick resumes/retries.\n377\t *\n378\t * opts:\n379\t *   stampPath   — override for testing (default ~/.claude/session-manager/history-rollup.stamp)\n380\t *   lockPath    — override for testing (default ~/.claude/session-manager/history-rollup.lock)\n381\t *   staleLockMs — lock staleness threshold (default 10 min)\n382\t *   budgetMs    — cap forwarded to finalizeClosedDays (default 60_000)\n383\t *   dryRun      — compute without writing (default SM_WATCHDOG_DRYRUN === '1')\n384\t *   finalizeFn  — injectable finalizeClosedDays for testing\n385\t */\n386\tasync function maybeFinalizeHistory({\n387\t  stampPath = DEFAULT_STAMP_PATH,\n388\t  lockPath = DEFAULT_LOCK_PATH,\n389\t  staleLockMs = DEFAULT_LOCK_STALE_MS,\n390\t  budgetMs = DEFAULT_FINALIZE_BUDGET_MS,\n391\t  dryRun = process.env.SM_WATCHDOG_DRYRUN === '1',\n392\t  finalizeFn = defaultFinalizeClosedDays,\n393\t} = {}) {\n394\t  const today = localDateStr();\n395\t\n396\t  if (readStampDate(stampPath) === today) {\n397\t    return { ran: false, reason: 'already-finalized-today', date: today };\n398\t  }\n399\t\n400\t  if (!tryAcquireLock(lockPath, staleLockMs)) {\n401\t    return { ran: false, reason: 'lock-contended', date: today };\n402\t  }\n403\t\n404\t  try {\n405\t    const result = await finalizeFn({ budgetMs, dryRun });\n406\t\n407\t    if (dryRun) {\n408\t      return { ran: false, reason: 'dry-run', date: today, finalizedDates: result.finalizedDates };\n409\t    }\n410\t\n411\t    if (!result.partial) {\n412\t      writeStampDate(stampPath, today);\n413\t      return { ran: true, reason: 'finalized', date: today, finalizedDates: result.finalizedDates };\n414\t    }\n415\t\n416\t    return { ran: true, reason: 'partial', date: today, finalizedDates: result.finalizedDates };\n417\t  } finally {\n418\t    releaseLock(lockPath);\n419\t  }\n420\t}\n421\t\n422\tmodule.exports = {\n423\t  readLastHeartbeat,\n424\t  readLastHeartbeatTs,\n425\t  heartbeatFresh,\n426\t  isPidAlive,\n427\t  localDateStr,\n428\t  maybeFinalizeHistory,\n429\t  tryAcquireLock,\n430\t  releaseLock,\n431\t  checkAppLiveness,\n432\t  readRelaunchState,\n433\t  writeRelaunchState,\n434\t  defaultSpawnRelaunch,\n435\t  maybeRelaunchApp,\n436\t  DEFAULT_HEARTBEAT_PATH,\n437\t  DEFAULT_MAX_AGE_MS,\n438\t  DEFAULT_STAMP_PATH,\n439\t  DEFAULT_LOCK_PATH,\n440\t  DEFAULT_LOCK_STALE_MS,\n441\t  DEFAULT_FINALIZE_BUDGET_MS,\n442\t  DEFAULT_RELAUNCH_STATE_PATH,\n443\t  DEFAULT_RELAUNCH_LOG_PATH,\n444\t  DEFAULT_RELAUNCH_DEBOUNCE_MS,\n445\t  DEFAULT_MAX_RELAUNCH_ATTEMPTS,\n446\t};\n447\t"}]},"parent_tool_use_id":null,"session_id":"5075ff69-e35d-4ac7-b38b-bfa9cd8abf1c","uuid":"9f21a9f0-12df-48fa-848a-7369bd24173d","timestamp":"2026-09-13T21:54:04.009Z","tool_use_result":{"type":"text","file":{"filePath":"/home/bilko/Projects/session-manager/scripts/lib/watchdogHelpers.cjs","content":"'use strict';\n\n// watchdogHelpers.cjs — pure helpers for scheduler-watchdog.cjs (no side effects).\n// Testable without spawning the watchdog entry script.\n\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\n\n\n// Mirrors scheduler.cjs:215 (single source of truth there; kept in sync here).\nconst DEFAULT_HEARTBEAT_PATH = path.join(\n  os.homedir(), '.claude', 'session-manager', 'scheduler-heartbeat.log',\n);\n\n// The in-app heartbeat ticks every 60 s; 3 missed ticks = stale.\nconst DEFAULT_MAX_AGE_MS = 180_000;\n\n/** Local-TZ 'YYYY-MM-DD' for `d` (default now). Single source of truth for\n *  the watchdog's notion of \"today\" — used for both the log filename and the\n *  history-rollup once-per-day gate. */\nfunction localDateStr(d = new Date()) {\n  const y = d.getFullYear();\n  const m = String(d.getMonth() + 1).padStart(2, '0');\n  const day = String(d.getDate()).padStart(2, '0');\n  return `${y}-${m}-${day}`;\n}\n\n// Tail bytes to read — enough to hold several JSON heartbeat lines without\n// loading a potentially 1 MB file. O(1) in file size.\nconst TAIL_BYTES = 4096;\n\n/**\n * readLastHeartbeat(heartbeatPath?) → object | null\n *\n * Reads the last ~4 KB of the heartbeat log, reverse-scans for the last\n * non-empty line, and returns the full parsed JSON object.\n * Returns null on missing / empty / unparseable file.\n *\n * Single source of truth for the file-read + reverse-scan logic; used by\n * readLastHeartbeatTs() and heartbeatFresh().\n */\nfunction readLastHeartbeat(heartbeatPath = DEFAULT_HEARTBEAT_PATH) {\n  let buf;\n  try {\n    const stat = fs.statSync(heartbeatPath);\n    const size = stat.size;\n    if (size === 0) return null;\n\n    const readSize = Math.min(TAIL_BYTES, size);\n    const fd = fs.openSync(heartbeatPath, 'r');\n    try {\n      buf = Buffer.alloc(readSize);\n      fs.readSync(fd, buf, 0, readSize, size - readSize);\n    } finally {\n      fs.closeSync(fd);\n    }\n  } catch {\n    return null;\n  }\n\n  const lines = buf.toString('utf8').split('\\n');\n  // Walk lines in reverse to find last non-empty parseable one.\n  for (let i = lines.length - 1; i >= 0; i--) {\n    const line = lines[i].trim();\n    if (!line) continue;\n    try {\n      return JSON.parse(line);\n    } catch {\n      return null;\n    }\n  }\n  return null;\n}\n\n/**\n * readLastHeartbeatTs(heartbeatPath?) → number | null\n *\n * Returns the `ts` field (epoch ms) from the last heartbeat entry.\n * Returns null on missing / empty / unparseable file or missing ts field.\n */\nfunction readLastHeartbeatTs(heartbeatPath = DEFAULT_HEARTBEAT_PATH) {\n  const entry = readLastHeartbeat(heartbeatPath);\n  return (entry !== null && typeof entry.ts === 'number') ? entry.ts : null;\n}\n\n/**\n * heartbeatFresh(heartbeatPath?, maxAgeMs?) → boolean\n *\n * Returns true iff the last heartbeat ts is within maxAgeMs of `now`.\n * Missing / empty / unparseable file → false.\n */\nfunction heartbeatFresh(heartbeatPath = DEFAULT_HEARTBEAT_PATH, maxAgeMs = DEFAULT_MAX_AGE_MS) {\n  const ts = readLastHeartbeatTs(heartbeatPath);\n  if (ts === null) return false;\n  return (Date.now() - ts) < maxAgeMs;\n}\n\n/**\n * isPidAlive(pid) → boolean\n *\n * Plain liveness check via process.kill(pid, 0) (no signal sent). Single\n * source of truth for the \"is this recorded pid still alive\" check used by\n * checkAppLiveness's defense-in-depth relaunch gate.\n *\n * EPERM (pid exists, owned by another user) counts as alive — only ESRCH\n * (no such process) means dead. Watchdog and app run as the same user in\n * practice, so this distinction rarely matters here, but treating EPERM as\n * \"dead\" would be wrong on its face (the process demonstrably exists).\n */\nfunction isPidAlive(pid) {\n  if (typeof pid !== 'number' || !Number.isFinite(pid)) return false;\n  try {\n    process.kill(pid, 0);\n    return true;\n  } catch (e) {\n    return e?.code === 'EPERM';\n  }\n}\n\n// Offline queue.json reconciliation (orphaned 'running' jobs whose pid died\n// while Electron wasn't running) used to live here as reconcileQueueOffline().\n// PRD 686 moved that responsibility into src/main/scheduler.cjs's own boot\n// path (partitionBootOrphans/applyOrphanOutcome) now that PRD 685's watchdog\n// relaunch means the app is never down long enough to need an external\n// reconciler — the in-app scheduler is queue.json's single owner again.\n\n// ── app liveness + auto-relaunch ─────────────────────────────────────────────\n//\n// The watchdog's one supervision job: is session-manager itself running, and\n// if not, start it. Reuses the existing scheduler heartbeat (written every\n// 60 s by scheduler.cjs's heartbeatInterval regardless of pause state) as the\n// liveness signal — no second heartbeat file.\n\nconst DEFAULT_RELAUNCH_STATE_PATH = path.join(\n  os.homedir(), '.claude', 'session-manager', 'watchdog-relaunch-state.json',\n);\nconst DEFAULT_RELAUNCH_LOG_PATH = path.join(\n  os.homedir(), '.claude', 'logs', 'scheduler-watchdog-relaunch.log',\n);\nconst DEFAULT_RELAUNCH_DEBOUNCE_MS = 90_000;\nconst DEFAULT_MAX_RELAUNCH_ATTEMPTS = 3;\n\n/**\n * checkAppLiveness(opts?) → { alive: boolean, reason: string }\n *\n * Primary signal: heartbeatFresh() within the existing max-age window.\n * Defense-in-depth: if the heartbeat is stale, but the pid it last recorded\n * is still alive (app under heavy load, tick just missed), treat as alive\n * rather than relaunching on top of a live process.\n */\nfunction checkAppLiveness({\n  heartbeatPath = DEFAULT_HEARTBEAT_PATH,\n  maxAgeMs = DEFAULT_MAX_AGE_MS,\n} = {}) {\n  if (heartbeatFresh(heartbeatPath, maxAgeMs)) {\n    return { alive: true, reason: 'heartbeat-fresh' };\n  }\n  const last = readLastHeartbeat(heartbeatPath);\n  if (last !== null && typeof last.pid === 'number' && isPidAlive(last.pid)) {\n    return { alive: true, reason: 'pid-alive-heartbeat-stale' };\n  }\n  return { alive: false, reason: 'stale-and-dead' };\n}\n\n/** Default { lastAttemptTs: null, attemptCount: 0 } on missing/unparseable state file. */\nfunction readRelaunchState(statePath = DEFAULT_RELAUNCH_STATE_PATH) {\n  try {\n    const raw = JSON.parse(fs.readFileSync(statePath, 'utf8'));\n    return {\n      lastAttemptTs: typeof raw.lastAttemptTs === 'number' ? raw.lastAttemptTs : null,\n      attemptCount: typeof raw.attemptCount === 'number' ? raw.attemptCount : 0,\n    };\n  } catch {\n    return { lastAttemptTs: null, attemptCount: 0 };\n  }\n}\n\n/** Atomic write: tmp-<pid>-<ts> → rename (mirrors config.cjs writeJsonSync). */\nfunction writeRelaunchState(statePath, state) {\n  fs.mkdirSync(path.dirname(statePath), { recursive: true });\n  const tmpPath = `${statePath}.tmp-${process.pid}-${Date.now()}`;\n  fs.writeFileSync(tmpPath, JSON.stringify(state, null, 2) + '\\n', 'utf8');\n  fs.renameSync(tmpPath, statePath);\n}\n\nfunction logRelaunchLine(logPath, message) {\n  try {\n    fs.mkdirSync(path.dirname(logPath), { recursive: true });\n    fs.appendFileSync(logPath, `${new Date().toISOString()} ${message}\\n`);\n  } catch (e) {\n    process.stderr.write(`[watchdog-relaunch] log write failed: ${e?.message}\\n`);\n  }\n}\n\n/**\n * defaultSpawnRelaunch(opts?) — launches a new session-manager instance the\n * same way a user would: `npx claude-code-session-manager@latest` (the\n * documented distribution method — CLAUDE.md's \"Distribution\" section), so\n * this keeps working across npm publishes with no local path to maintain.\n *\n * Detached + stdio redirected to logPath + unref()'d so the watchdog's own\n * (short-lived) process doesn't block on the launched app and the app\n * survives the watchdog exiting.\n */\nfunction defaultSpawnRelaunch({ logPath = DEFAULT_RELAUNCH_LOG_PATH } = {}) {\n  const { spawn } = require('node:child_process');\n  fs.mkdirSync(path.dirname(logPath), { recursive: true });\n  const fd = fs.openSync(logPath, 'a');\n  try {\n    const child = spawn('npx', ['claude-code-session-manager@latest'], {\n      detached: true,\n      stdio: ['ignore', fd, fd],\n    });\n    child.on('error', (e) => {\n      logRelaunchLine(logPath, `spawn error: ${e?.message}`);\n    });\n    child.unref();\n  } finally {\n    fs.closeSync(fd);\n  }\n}\n\n/**\n * maybeRelaunchApp(opts?) → { relaunched: boolean, reason: string, attemptCount: number }\n *\n * Debounced, capped auto-relaunch:\n *   - alive (heartbeat fresh or pid alive)             → no-op, reset attempt state.\n *   - dead + attemptCount already at maxAttempts         → skip, log diagnostic (give up).\n *   - dead + last attempt < debounceMs ago                → skip (still booting).\n *   - dead + debounce elapsed + under cap               → spawn, bump attemptCount, log.\n *\n * attemptCount only resets to 0 once a fresh heartbeat is observed (i.e. a\n * relaunch actually succeeded), so 3 relaunch attempts that each fail to\n * produce a fresh heartbeat permanently cap further attempts until a human\n * intervenes or the app comes up some other way.\n */\nfunction maybeRelaunchApp({\n  heartbeatPath = DEFAULT_HEARTBEAT_PATH,\n  maxAgeMs = DEFAULT_MAX_AGE_MS,\n  statePath = DEFAULT_RELAUNCH_STATE_PATH,\n  logPath = DEFAULT_RELAUNCH_LOG_PATH,\n  debounceMs = DEFAULT_RELAUNCH_DEBOUNCE_MS,\n  maxAttempts = DEFAULT_MAX_RELAUNCH_ATTEMPTS,\n  now = Date.now(),\n  spawnFn = defaultSpawnRelaunch,\n} = {}) {\n  const liveness = checkAppLiveness({ heartbeatPath, maxAgeMs });\n  const state = readRelaunchState(statePath);\n\n  if (liveness.alive) {\n    if (state.attemptCount !== 0 || state.lastAttemptTs !== null) {\n      writeRelaunchState(statePath, { lastAttemptTs: null, attemptCount: 0 });\n    }\n    return { relaunched: false, reason: 'alive', attemptCount: 0 };\n  }\n\n  if (state.attemptCount >= maxAttempts) {\n    logRelaunchLine(\n      logPath,\n      `giving up: ${state.attemptCount} relaunch attempt(s) already made and heartbeat is still stale — manual intervention required`,\n    );\n    return { relaunched: false, reason: 'capped', attemptCount: state.attemptCount };\n  }\n\n  if (state.lastAttemptTs !== null && (now - state.lastAttemptTs) < debounceMs) {\n    return { relaunched: false, reason: 'debounce', attemptCount: state.attemptCount };\n  }\n\n  const attemptCount = state.attemptCount + 1;\n  spawnFn({ logPath });\n  writeRelaunchState(statePath, { lastAttemptTs: now, attemptCount });\n  logRelaunchLine(\n    logPath,\n    `relaunch attempt ${attemptCount}/${maxAttempts}: spawning \"npx claude-code-session-manager@latest\" (heartbeat stale, last-known pid dead)`,\n  );\n  return { relaunched: true, reason: 'launched', attemptCount };\n}\n\n// ── maybeFinalizeHistory ─────────────────────────────────────────────────────\n//\n// Precomputes closed History-dashboard days outside Electron, so the app's\n// first paint after a boot (possibly weeks after the app was last open) is\n// instant, and old transcripts stay safe to age out without losing analytics.\n// See src/main/historyAggregator.cjs's finalizeClosedDays() for the actual\n// walk/persist logic — this is just the once-per-day scheduling + lock\n// wrapper around it, tailored to being invoked repeatedly by a systemd timer.\n\nconst DEFAULT_STAMP_PATH = path.join(\n  os.homedir(), '.claude', 'session-manager', 'history-rollup.stamp',\n);\nconst DEFAULT_LOCK_PATH = path.join(\n  os.homedir(), '.claude', 'session-manager', 'history-rollup.lock',\n);\nconst DEFAULT_LOCK_STALE_MS = 10 * 60 * 1000; // 10 min\nconst DEFAULT_FINALIZE_BUDGET_MS = 60_000;\n\nfunction readStampDate(stampPath) {\n  try {\n    return fs.readFileSync(stampPath, 'utf8').trim();\n  } catch {\n    return null;\n  }\n}\n\n/** Atomic write: tmp-<pid>-<ts> → rename (mirrors config.cjs writeJsonSync). */\nfunction writeStampDate(stampPath, date) {\n  fs.mkdirSync(path.dirname(stampPath), { recursive: true });\n  const tmpPath = `${stampPath}.tmp-${process.pid}-${Date.now()}`;\n  fs.writeFileSync(tmpPath, date, 'utf8');\n  fs.renameSync(tmpPath, stampPath);\n}\n\n/**\n * tryAcquireLock(lockPath, staleMs) → boolean\n *\n * O_EXCL ('wx') lock file so the in-app Electron boot pass and this cron\n * pass never interleave writes to the rollup. A lock older than staleMs is\n * assumed abandoned (a crashed holder) and reclaimed; otherwise the caller\n * loses the race and must skip silently.\n */\nfunction tryAcquireLock(lockPath, staleMs = DEFAULT_LOCK_STALE_MS) {\n  fs.mkdirSync(path.dirname(lockPath), { recursive: true });\n  try {\n    fs.writeFileSync(lockPath, String(process.pid), { flag: 'wx' });\n    return true;\n  } catch (e) {\n    if (e.code !== 'EEXIST') throw e;\n  }\n\n  let st;\n  try {\n    st = fs.statSync(lockPath);\n  } catch {\n    st = null; // lock vanished between our failed create and this stat\n  }\n\n  if (st !== null && Date.now() - st.mtimeMs <= staleMs) {\n    return false; // held by a live (or at least recent) owner — loser skips\n  }\n\n  // Stale (or already gone) — reclaim. The unlink+wx pair isn't atomic, so\n  // two concurrent reclaimers could theoretically both win here — but that\n  // only happens when the prior holder already crashed/vanished, and the\n  // resulting \"both run finalize\" outcome is benign: appendRollupDays is\n  // append-only + last-write-wins-deduped, so a redundant concurrent pass\n  // costs extra work, not corrupted data.\n  try {\n    if (st !== null) fs.unlinkSync(lockPath);\n    fs.writeFileSync(lockPath, String(process.pid), { flag: 'wx' });\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nfunction releaseLock(lockPath) {\n  try { fs.unlinkSync(lockPath); } catch { /* already gone / never created */ }\n}\n\n/** Lazily require historyAggregator.cjs — deferred so a missing PRD-650\n *  dependency fails inside maybeFinalizeHistory's try/catch, not at require\n *  time for the whole watchdog script. */\nfunction defaultFinalizeClosedDays(opts) {\n  const { finalizeClosedDays } = require('../../src/main/historyAggregator.cjs');\n  return finalizeClosedDays(opts);\n}\n\n/**\n * maybeFinalizeHistory(opts?) → Promise<{ ran, reason, date, finalizedDates? }>\n *\n * Runs at most once per local day (stamp-file gated, O(1) same-day skip).\n * Guards against interleaving with the in-app Electron boot pass via an\n * O_EXCL lock file. Bounded by opts.budgetMs so a huge transcript corpus\n * can't make a single watchdog tick run long; a budget-partial pass does\n * NOT stamp the day complete, so a later tick resumes/retries.\n *\n * opts:\n *   stampPath   — override for testing (default ~/.claude/session-manager/history-rollup.stamp)\n *   lockPath    — override for testing (default ~/.claude/session-manager/history-rollup.lock)\n *   staleLockMs — lock staleness threshold (default 10 min)\n *   budgetMs    — cap forwarded to finalizeClosedDays (default 60_000)\n *   dryRun      — compute without writing (default SM_WATCHDOG_DRYRUN === '1')\n *   finalizeFn  — injectable finalizeClosedDays for testing\n */\nasync function maybeFinalizeHistory({\n  stampPath = DEFAULT_STAMP_PATH,\n  lockPath = DEFAULT_LOCK_PATH,\n  staleLockMs = DEFAULT_LOCK_STALE_MS,\n  budgetMs = DEFAULT_FINALIZE_BUDGET_MS,\n  dryRun = process.env.SM_WATCHDOG_DRYRUN === '1',\n  finalizeFn = defaultFinalizeClosedDays,\n} = {}) {\n  const today = localDateStr();\n\n  if (readStampDate(stampPath) === today) {\n    return { ran: false, reason: 'already-finalized-today', date: today };\n  }\n\n  if (!tryAcquireLock(lockPath, staleLockMs)) {\n    return { ran: false, reason: 'lock-contended', date: today };\n  }\n\n  try {\n    const result = await finalizeFn({ budgetMs, dryRun });\n\n    if (dryRun) {\n      return { ran: false, reason: 'dry-run', date: today, finalizedDates: result.finalizedDates };\n    }\n\n    if (!result.partial) {\n      writeStampDate(stampPath, today);\n      return { ran: true, reason: 'finalized', date: today, finalizedDates: result.finalizedDates };\n    }\n\n    return { ran: true, reason: 'partial', date: today, finalizedDates: result.finalizedDates };\n  } finally {\n    releaseLock(lockPath);\n  }\n}\n\nmodule.exports = {\n  readLastHeartbeat,\n  readLastHeartbeatTs,\n  heartbeatFresh,\n  isPidAlive,\n  localDateStr,\n  maybeFinalizeHistory,\n  tryAcquireLock,\n  releaseLock,\n  checkAppLiveness,\n  readRelaunchState,\n  writeRelaunchState,\n  defaultSpawnRelaunch,\n  maybeRelaunchApp,\n  DEFAULT_HEARTBEAT_PATH,\n  DEFAULT_MAX_AGE_MS,\n  DEFAULT_STAMP_PATH,\n  DEFAULT_LOCK_PATH,\n  DEFAULT_LOCK_STALE_MS,\n  DEFAULT_FINALIZE_BUDGET_MS,\n  DEFAULT_RELAUNCH_STATE_PATH,\n  DEFAULT_RELAUNCH_LOG_PATH,\n  DEFAULT_RELAUNCH_DEBOUNCE_MS,\n  DEFAULT_MAX_RELAUNCH_ATTEMPTS,\n};\n","numLines":447,"startLine":1,"totalLines":447}}}
