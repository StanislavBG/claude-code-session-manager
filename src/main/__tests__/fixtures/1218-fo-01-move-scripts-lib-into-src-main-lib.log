{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qmo5L1X8HFL85Cqgk9KJdC","type":"tool_result","content":"1\t'use strict';\n2\t\n3\t// Run: timeout 120 npx vitest run scripts/__tests__/active-sessions.test.cjs\n4\t\n5\timport { vi } from 'vitest';\n6\tconst assert = require('node:assert/strict');\n7\tconst fs = require('node:fs');\n8\tconst os = require('node:os');\n9\tconst path = require('node:path');\n10\tconst { activeProjectCwds, allProjectCwds, bustProjectCwdCache } = require('../lib/activeSessions.cjs');\n11\t\n12\tfunction tmpDir() {\n13\t  return fs.mkdtempSync(path.join(os.tmpdir(), 'active-sessions-test-'));\n14\t}\n15\t\n16\tfunction writeTranscript(projectsDir, slug, fileName, cwd, mtimeMsAgo) {\n17\t  const projDir = path.join(projectsDir, slug);\n18\t  fs.mkdirSync(projDir, { recursive: true });\n19\t  const fp = path.join(projDir, fileName);\n20\t  fs.writeFileSync(fp, JSON.stringify({ cwd }) + '\\n');\n21\t  const mtime = new Date(Date.now() - mtimeMsAgo);\n22\t  fs.utimesSync(fp, mtime, mtime);\n23\t  return fp;\n24\t}\n25\t\n26\ttest('two recent + one stale + one nonexistent → returns exactly the two recent existing cwds', () => {\n27\t  const base = tmpDir();\n28\t  try {\n29\t    const projectsDir = path.join(base, 'projects');\n30\t    const cwdA = path.join(base, 'proj-a');\n31\t    const cwdB = path.join(base, 'proj-b');\n32\t    const cwdC = path.join(base, 'proj-c');       // stale — exists on disk\n33\t    const cwdMissing = path.join(base, 'proj-missing'); // never created\n34\t    fs.mkdirSync(cwdA);\n35\t    fs.mkdirSync(cwdB);\n36\t    fs.mkdirSync(cwdC);\n37\t\n38\t    const MAX_AGE_MIN = 90;\n39\t    writeTranscript(projectsDir, 'slug-a', 'a.jsonl', cwdA, 10 * 60 * 1000);\n40\t    writeTranscript(projectsDir, 'slug-b', 'b.jsonl', cwdB, 10 * 60 * 1000);\n41\t    writeTranscript(projectsDir, 'slug-c', 'c.jsonl', cwdC, 120 * 60 * 1000);\n42\t    writeTranscript(projectsDir, 'slug-missing', 'm.jsonl', cwdMissing, 10 * 60 * 1000);\n43\t\n44\t    const result = activeProjectCwds(MAX_AGE_MIN, { projectsDir });\n45\t\n46\t    assert.equal(\n47\t      result.length, 2,\n48\t      `expected 2 cwds, got ${result.length}: ${JSON.stringify(result)}`,\n49\t    );\n50\t    assert.ok(result.includes(cwdA), `cwdA must be in result`);\n51\t    assert.ok(result.includes(cwdB), `cwdB must be in result`);\n52\t    assert.ok(!result.includes(cwdC),       'stale cwdC must not appear');\n53\t    assert.ok(!result.includes(cwdMissing), 'nonexistent path must not appear');\n54\t  } finally {\n55\t    fs.rmSync(base, { recursive: true, force: true });\n56\t  }\n57\t});\n58\t\n59\ttest('duplicate cwd across two project dirs → deduped to one entry', () => {\n60\t  const base = tmpDir();\n61\t  try {\n62\t    const projectsDir = path.join(base, 'projects');\n63\t    const cwdA = path.join(base, 'proj-a');\n64\t    fs.mkdirSync(cwdA);\n65\t\n66\t    writeTranscript(projectsDir, 'slug-1', 'a.jsonl', cwdA, 5 * 60 * 1000);\n67\t    writeTranscript(projectsDir, 'slug-2', 'b.jsonl', cwdA, 5 * 60 * 1000);\n68\t\n69\t    const result = activeProjectCwds(90, { projectsDir });\n70\t    assert.equal(result.length, 1, 'duplicate cwd must be deduped');\n71\t    assert.equal(result[0], cwdA);\n72\t  } finally {\n73\t    fs.rmSync(base, { recursive: true, force: true });\n74\t  }\n75\t});\n76\t\n77\ttest('missing projects dir → empty result', () => {\n78\t  const base = tmpDir();\n79\t  try {\n80\t    const result = activeProjectCwds(90, { projectsDir: path.join(base, 'no-such-dir') });\n81\t    assert.deepEqual(result, []);\n82\t  } finally {\n83\t    fs.rmSync(base, { recursive: true, force: true });\n84\t  }\n85\t});\n86\t\n87\ttest('prompts.jsonl absent → transcripts still detected (sole detection path)', () => {\n88\t  const base = tmpDir();\n89\t  try {\n90\t    // No knowledge-log / prompts.jsonl anywhere in this tmp tree — the\n91\t    // function must not need it. logPath, if passed, is a harmless no-op.\