{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/main/lib/promptSessionSchema.cjs",
    "src/main/lib/agentPersonaSchema.cjs",
    "src/main/lib/scheduleJobSchema.cjs",
    "src/main/ipcSchemas.cjs"
  ]
}
